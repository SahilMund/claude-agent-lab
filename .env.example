# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Required for llm.provider = anthropic (the default in config.yaml).
ANTHROPIC_API_KEY=

# Required only if you switch embedding.provider to "voyage" in config.yaml.
VOYAGE_API_KEY=

# Optional: override any config.yaml value without editing the checked-in
# file. Naming: AGENT_LAB_<SECTION>_<FIELD>. Examples:
# AGENT_LAB_LLM_MODEL=claude-sonnet-5
# AGENT_LAB_LLM_MAX_TOKENS=8000
# AGENT_LAB_EMBEDDING_PROVIDER=voyage
# AGENT_LAB_LOG_LEVEL=DEBUG
