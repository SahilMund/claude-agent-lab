# Copy to .env and fill in real values. .env is gitignored — never commit it.

# LLM provider — set config.yaml's llm.provider to one of these, and fill in only the
# matching key below. Switching providers needs no code change, just a config edit.
# anthropic (default) — the CLI's default LLM provider.
ANTHROPIC_API_KEY=
# openai — also used by embeddings.provider: openai, independent of llm.provider.
OPENAI_API_KEY=
# gemini
GOOGLE_API_KEY=
# groq
GROQ_API_KEY=
# ollama needs no API key — it talks to a local server instead. Only set this if
# your Ollama server isn't at the default http://localhost:11434.
OLLAMA_BASE_URL=

# Qdrant connection (config.yaml: vector_store.provider: qdrant). Leave both unset to
# connect to a local server at the qdrant-client default (http://localhost:6333) —
# run one with: docker run -p 6333:6333 qdrant/qdrant
# Set both to point at a remote/cloud Qdrant instance instead.
QDRANT_URL=
QDRANT_API_KEY=

# Only needed if the "github" MCP server in mcp_servers.json is actually used —
# a GitHub personal access token with repo read access.
GITHUB_TOKEN=

# Redis for the semantic cache (config.yaml: semantic_cache.enabled: true).
# Not required to run the CLI — build_semantic_cache() catches a connection
# failure and disables caching instead of crashing. Default redis_url in
# config.yaml already points at redis://localhost:6379.
